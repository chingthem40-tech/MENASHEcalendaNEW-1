# Netlify redirect rules for the Menashe Calendar SPA
#
# 1. Proxy /api/* to the production API server.
#    The Netlify build replaces this placeholder using NETLIFY_API_URL.
#    NETLIFY_API_URL must be the HTTPS origin of the deployed Express API,
#    without a path, query string, or trailing slash.
#
/api/*  https://YOUR_API_SERVER_URL/api/:splat  200

# 2. SPA fallback — all other routes serve index.html so that Wouter
#    history-mode routing works on direct navigation and browser refresh.
/*  /index.html  200
